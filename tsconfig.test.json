{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "types": ["node", "jest"]
  },
  "include": ["src/**/*.test.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "test-_development/**/*",
    "test_development/**/*",
    "src/test-_development/**/*",
    "src/test_development/**/*"
  ]
}
