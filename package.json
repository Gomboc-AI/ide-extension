{
  "name": "gomboc-vscode-extension",
  "displayName": "Gomboc",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.97.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gomboc-vscode-extension.testApiKey",
        "title": "Gomboc: Test API Key"
      },
      {
        "command": "gomboc-vscode-extension.scanFile",
        "title": "Gomboc: Scan current file or scenario"
      },
      {
        "command": "gomboc-vscode-extension.scanAllFiles",
        "title": "Gomboc: Scan all files or scenarios in repository"
      },
      {
        "command": "gomboc-vscode-extension.showFrameworks",
        "title": "Gomboc: Show organization frameworks"
      }
    ],
    "configuration": [
      {
        "type": "object",
        "properties": {
          "gomboc-vscode-extension.apiKey": {
            "type": "string",
            "default": "",
            "description": "API Key for accessing the server.",
            "sensitive": true
          },
          "gomboc-vscode-extension.scanOnFileSave": {
            "type": "boolean",
            "default": false,
            "description": "Scan file every time file saves if true"
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir dist",
    "watch-tests": "tsc -p . -w --outDir dist",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "test": "vscode-test",
    "lint": "eslint src && npm run typecheck",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "graphql:generate": "graphql-codegen --config src/api/codegen.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/react": "^19.0.8",
    "@types/vscode": "^1.97.0",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.24.2",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.6",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.2.5",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@apollo/client": "^3.12.11",
    "dotenv": "^16.4.7",
    "graphql-tag": "^2.12.6",
    "neverthrow": "^8.1.1",
    "react": "^19.0.0",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  }
}
