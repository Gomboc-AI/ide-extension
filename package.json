{
  "name": "gomboc-vscode-extension",
  "publisher": "GombocAI",
  "displayName": "Gomboc",
  "description": "Find and fix infrastructure as code misconfigurations",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gomboc-AI/ide-extension"
  },
  "homepage": "https://github.com/Gomboc-AI/ide-extension?tab=readme-ov-file",
  "version": "0.0.13",
  "engines": {
    "vscode": "^1.63.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "icon": "./static/Gomboc-Full-Logo.png",
  "main": "./dist/extension.js",
  "extensionDependencies": [
    "vscode.git"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gomboc-vscode-extension.testApiKey",
        "title": "Gomboc: Test API Key"
      },
      {
        "command": "gomboc-vscode-extension.scanFile",
        "title": "Gomboc: Scan current file or scenario"
      },
      {
        "command": "gomboc-vscode-extension.showBenchmarks",
        "title": "Gomboc: Show organization benchmarks"
      }
    ],
    "configuration": [
      {
        "type": "object",
        "properties": {
          "gomboc-vscode-extension.apiKey": {
            "type": "string",
            "default": "",
            "description": "API Key for accessing the server.",
            "sensitive": true
          },
          "gomboc-vscode-extension.scanOnFileSave": {
            "type": "boolean",
            "default": false,
            "description": "Scan file every time file saves if true"
          },
          "gomboc-vscode-extension.defaultBranchName": {
            "type": "string",
            "default": "main",
            "description": "Default main branch for reporting purposes"
          },
          "gomboc-vscode-extension.useCustomEndpoint": {
            "type": "boolean",
            "default": false,
            "description": "When enabled will send requests to custom specified endpoint"
          },
          "gomboc-vscode-extension.serviceEndpoint": {
            "type": "string",
            "default": "https://api.app.gomboc.ai/graphql",
            "description": "When enabled will send requests to custom specified endpoint (default is 'https://api.app.gomboc.ai/graphql')"
          }
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gombocSidebar",
          "title": "Gomboc",
          "icon": "./static/GombocWhiteLogo.png"
        }
      ]
    },
    "views": {
      "gombocSidebar": [
        {
          "id": "gombocInfoView",
          "name": "Gomboc info",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir dist",
    "watch-tests": "tsc -p . -w --outDir dist",
    "version": "auto-changelog -p && git add CHANGELOG.md",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src && npm run typecheck",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "graphql:generate": "graphql-codegen --config src/api/codegen.ts",
    "prepare": "husky",
    "commit": "cz"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@graphql-codegen/cli": "^5.0.4",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/react": "^19.0.8",
    "@types/vscode": "^1.63.0",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^2.15.0",
    "auto-changelog": "^2.5.0",
    "cz-conventional-changelog": "^3.3.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.6",
    "jest": "^30.0.4",
    "jest-environment-jsdom": "^30.0.4",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.2.5",
    "semantic-release": "^24.2.3",
    "semantic-release-unsquash": "^0.3.0",
    "semantic-release-vsce": "^6.0.7",
    "ts-jest": "^29.4.0",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@apollo/client": "^3.12.11",
    "axios": "^1.12.0",
    "dotenv": "^16.4.7",
    "file-type": "^20.1.0",
    "graphql-tag": "^2.12.6",
    "neverthrow": "^8.1.1",
    "react": "^19.0.0",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
